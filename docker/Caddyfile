# Caddy reverse proxy for XWizard.
#
# SITE_ADDRESS and TLS_EMAIL are injected from the environment (see .env).
# When SITE_ADDRESS is a real domain name, Caddy automatically obtains and
# renews a Let's Encrypt TLS certificate. Use ":80" for a quick HTTP-only test.

{
	# Email for Let's Encrypt expiry/renewal notices (recommended).
	email {$TLS_EMAIL}
}

{$SITE_ADDRESS} {
	encode zstd gzip

	# XWizard is served under the /XWizard context path. Send the bare site
	# root to the app's help entrypoint for convenience.
	redir / /XWizard/Wizz?help 302

	reverse_proxy app:8080
}
