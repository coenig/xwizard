# Copy this file to `.env` and edit the values before deploying.
#   cp .env.example .env
# `.env` is git-ignored and holds your real secrets.

# --- Reverse proxy / TLS ---------------------------------------------------
# Public address Caddy serves. Use your domain for automatic HTTPS, e.g.
# xwizard.example.com (a DNS A/AAAA record must point at this server).
# For a quick HTTP-only test on the server itself, use ":80".
SITE_ADDRESS=xwizard.example.com

# Email used by Let's Encrypt for certificate notices (recommended).
TLS_EMAIL=admin@example.com

# --- Database --------------------------------------------------------------
# Schema name (created and seeded on first boot).
DB_NAME=xwizard

# Application database user (non-root) and its password. CHANGE THE PASSWORD.
DB_USER=xwizard
DB_PASSWORD=change-me-app-password

# --- Watchdog notification email (optional) --------------------------------
# Gmail account + App Password (not your regular password - generate one at
# https://myaccount.google.com/apppasswords) used to send Watchdog alerts.
# Leave unset to just skip sending (logged, not fatal).
SMTP_USERNAME=
SMTP_PASSWORD=

# MySQL root password (admin + healthcheck). CHANGE THIS.
MYSQL_ROOT_PASSWORD=change-me-root-password
